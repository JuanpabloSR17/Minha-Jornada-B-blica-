# Copie para .env e preencha com os dados do seu projeto Supabase
# (Painel Supabase → Project Settings → API). Use SOMENTE a chave pública (anon/publishable).
# Nunca coloque a service role key no aplicativo.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica
