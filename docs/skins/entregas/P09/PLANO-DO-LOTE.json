    },
    {
      "id": "glorioso_pedro_sobre_as_aguas",
      "identidadeFacial": "Adulto jovem; rosto hexagonal de têmporas largas e queixo estreito arredondado, nariz convexo com ponta curta, olhos grandes elevados, sobrancelhas oblíquas e barba curta escura afilada; surpresa e confiança."
    },
    {
      "id": "glorioso_joao_batista_no_jordao",
      "identidadeFacial": "Adulto; rosto trapezoidal com testa estreita e maxilar largo, nariz largo de ponte baixa, olhos próximos retos e sobrancelhas baixas; barba média arredondada sem bifurcação; expressão concentrada serena."
    },
    {
      "id": "glorioso_maria_madalena_na_manha_da_ressurreicao",
      "identidadeFacial": "Adulta jovem; rosto oval curto de bochechas inferiores cheias, nariz curto de base larga, olhos amendoados afastados de pálpebras suaves, sobrancelhas arqueadas finas e boca larga; alívio e alegria contida."
    },
    {
      "id": "glorioso_os_magos_e_a_estrela",
      "identidadeFacial": "Adulto maduro; rosto largo em escudo, testa abaulada, nariz comprido de base estreita, olhos pequenos amendoados sob sobrancelhas curvas, lábio superior estreito e barba densa curta com base reta; expressão contemplativa."
    }
  ],
  "pedidoUsuario": "Rosto próprio por Lendária/Gloriosa; três estilos; só sexo do personagem; apóstolos jovens e João em Patmos ancião; aguardar revisão do Claude antes de avançar."
