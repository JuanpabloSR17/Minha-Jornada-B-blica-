  "direcaoFacial": [
    {
      "id": "lendario_jonas",
      "identidadeFacial": "Adulto de meia-idade; rosto compacto largo de bochechas cheias, nariz curto largo de ponte baixa, olhos pequenos de pálpebras pesadas, queixo arredondado liso e bigode cheio aparado; sem barba nas faces nem no queixo."
    },
    {
      "id": "glorioso_daniel_na_cova_dos_leoes",
      "identidadeFacial": "Ancião; testa alta com linhas horizontais, rosto comprido de maçãs cheias, nariz aquilino estreito, olhos pequenos serenos e barba longa de base retangular."
    },
    {
      "id": "glorioso_isaias_e_a_brasa_do_altar",
      "identidadeFacial": "Adulto maduro; rosto hexagonal magro, maçãs altas com sulcos abaixo, nariz estreito com desvio sutil, olhos alongados elevados e barba curta rala que deixa os lábios visíveis."
    },
    {
      "id": "glorioso_jonas_e_o_grande_peixe",
      "identidadeFacial": "Adulto; rosto oval largo, maxilar arredondado pesado, nariz curto arrebitado, orelhas arredondadas, olhos grandes afastados e barba curta encaracolada; expressão de alívio."
    },
    {
      "id": "glorioso_ezequiel_no_vale_de_ossos",
      "identidadeFacial": "Maduro; rosto largo e plano de contorno retangular, testa baixa, nariz achatado largo, olhos oblíquos fundos, sobrancelhas arqueadas assimétricas e barba média em leque."
    },
    {
      "id": "lendario_joao_batista",
      "identidadeFacial": "Adulto; rosto estreito em cunha, testa plana com sobrancelhas muito arqueadas, nariz grande de ponta voltada para baixo, boca larga e barba áspera bifurcada."
    }
  ],
