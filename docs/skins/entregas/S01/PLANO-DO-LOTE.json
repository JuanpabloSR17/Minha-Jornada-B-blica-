  "direcaoFacial": [
    {
      "id": "epico_raquel",
      "identidadeFacial": "Adulta jovem; rosto alongado em coração, testa ampla, queixo estreito arredondado, nariz longo reto de ponta fina, olhos amendoados afastados e sobrancelhas cheias arqueadas; expressão atenta acolhedora."
    },
    {
      "id": "epico_lia",
      "identidadeFacial": "Adulta; rosto arredondado em pera, bochechas inferiores cheias, queixo amplo curto, nariz curto de base larga, olhos próximos suaves e sobrancelhas baixas curvas; expressão serena digna."
    },
    {
      "id": "epico_abel",
      "identidadeFacial": "Adulto jovem; rosto trapezoidal curto de mandíbula larga, testa baixa, nariz pequeno arrebitado, olhos redondos próximos e sobrancelhas retas espessas; barba curta só no queixo e bigode delicado, expressão gentil."
    },
    {
      "id": "epico_enoque",
      "identidadeFacial": "Adulto maduro; rosto oval muito estreito e comprido, maçãs altas, nariz aquilino fino e comprido, olhos fundos estreitos, sobrancelhas finas elevadas e barba média afilada única; expressão contemplativa."
    },
    {
      "id": "epico_melquisedeque",
      "identidadeFacial": "Adulto maduro; rosto quadrado largo, testa curta, nariz largo de ponte baixa, olhos horizontais pequenos, sobrancelhas curvas separadas e barba densa de base angulada; expressão hospitaleira firme."
    },
    {
      "id": "epico_agar",
      "identidadeFacial": "Adulta; rosto angular em escudo, testa alta estreita, maçãs salientes e queixo largo arredondado, nariz comprido de base ampla, olhos grandes oblíquos e sobrancelhas assimétricas arqueadas; expressão resiliente aliviada."
    }
  ],
  "pedidoUsuario": "Mesmo 2.5D, 3 estilos exatos, personagens só no próprio sexo, rosto próprio preservado por skin; entregar e aguardar revisão/ciclo do Claude antes do próximo par."
