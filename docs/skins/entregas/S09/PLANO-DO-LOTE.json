    },
    {
      "id": "raro_obede_edom",
      "identidadeFacial": "Adulto acolhedor de rosto quadrado curto, testa ampla, nariz curto côncavo e largo, olhos redondos afastados e sobrancelhas suaves arqueadas; bigode espesso e barba curta com covinha no queixo, expressão calorosa."
    },
    {
      "id": "raro_ciro",
      "identidadeFacial": "Rei adulto maduro de rosto trapezoidal largo, testa baixa, queixo retangular, nariz longo de ponte alta e ponta descendente, olhos amendoados fundos e sobrancelhas retas; barba média densa de contorno quadrado, expressão ponderada firme."
    },
    {
      "id": "raro_josue_o_sumo_sacerdote",
      "identidadeFacial": "Adulto maduro de rosto hexagonal baixo e largo, maxilar firme, nariz reto curto de base larga, olhos amendoados afastados de pálpebras pesadas e sobrancelhas retas cheias; barba curta em cunha e expressão restaurada tranquila."
    },
    {
      "id": "raro_elcana",
      "identidadeFacial": "Adulto de rosto losangular com testa ampla e queixo estreito, nariz curto de base larga, olhos ovais próximos e sobrancelhas grossas oblíquas; barba média bifurcada e expressão afetuosa determinada."
    }
