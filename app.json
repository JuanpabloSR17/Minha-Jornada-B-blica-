{
  "expo": {
    "name": "Jornada Bíblica",
    "slug": "jornada-biblica",
    "scheme": "jornadabiblica",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#151225",
    "icon": "./assets/brand/icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.jornadabiblica" },
    "android": {
      "package": "app.jornadabiblica",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": { "foregroundImage": "./assets/brand/adaptive-icon.png", "backgroundColor": "#151225" }
    },
    "web": { "output": "single", "bundler": "metro", "favicon": "./assets/brand/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", {
        "backgroundColor": "#151225",
        "image": "./assets/brand/emblem.png",
        "imageWidth": 200,
        "resizeMode": "contain"
      }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
